{
  "name": "gcode-lab",
  "productName": "G-Code Lab",
  "version": "1.0.3",
  "description": "G-Code Lab — симулятор стойки Fanuc: 3D-фрезеровка по G-коду",
  "author": {
    "name": "Олег Тануки",
    "email": "zxcvoid@gmail.com"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.tanukihitokiri.gcodelab",
    "productName": "G-Code Lab",
    "copyright": "© 2026 Олег. Личное использование.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "build/icon.ico",
      "!**/*.map"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GCodeLab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G-Code Lab",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "uninstallDisplayName": "G-Code Lab"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-builder": true
  }
}